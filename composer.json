{
    "name": "siberfx/turkiye-address",
    "description": "Laravel package for seeding Turkish address (city, district, neighborhood) tables from SQL dumps.",
    "keywords": [
        "laravel",
        "turkey",
        "address",
        "city",
        "district",
        "neighborhood",
        "seeder",
        "sql"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Selim Görmüş",
            "email": "info@siberfx.com",
            "homepage": "https://siberfx.com",
            "role": "Software Engineer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Siberfx\\TurkiyePackage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\TurkiyePackage\\TurkiyeAdreslerServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/siberfx/turkiye-il-ilce-mahalle/issues",
        "source": "https://github.com/siberfx/turkiye-il-ilce-mahalle"
    },
    "scripts": {
        "test": "php vendor/bin/phpunit"
    }
}
